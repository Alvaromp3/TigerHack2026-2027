# Backend env example — copy to .env and fill in values
CORS_ORIGINS=http://localhost:5173

# Auth0 (SPA login).
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your_client_id

# Local Postgres from docker-compose.yml at the repo root.
DATABASE_URL=postgresql+psycopg://tigerhack:tigerhack@localhost:5433/tigerhack

# OpenRouter hosts the operations assistant. The key stays on the backend only.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
